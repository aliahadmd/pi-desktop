{
  "name": "pi-desktop",
  "version": "0.1.0",
  "description": "macOS Electron client for the Pi coding agent",
  "type": "module",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "fix:pty": "node scripts/fix-spawn-helper.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest --run",
    "test:watch": "vitest",
    "e2e": "vitest --run --config vitest.e2e.config.ts",
    "dist:mac": "npm run build && electron-builder --mac --dir",
    "dist:mac:dmg": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@tanstack/react-virtual": "3.14.10",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "ansi-to-react": "6.2.6",
    "better-sqlite3": "13.0.3",
    "codemirror-shiki": "0.3.0",
    "electron-updater": "6.8.9",
    "lucide-react": "^1.33.0",
    "motion": "13.1.1",
    "node-pty": "1.1.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.4.3",
    "typebox": "^1.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "electron@44.0.0": true
  },
  "overrides": {
    "linkify-it": "^6.1.0"
  }
}
